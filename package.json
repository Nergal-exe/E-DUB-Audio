{
  "name": "e-dub-audio",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "prebuild": "node scripts/vendor.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@lofcz/deepfilternet-web": "^0.1.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.edub.audio",
    "productName": "E-DUB Audio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "compression": "normal",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "include": "installer/custom.nsh",
      "artifactName": "E-DUB Audio Setup ${version}.${ext}",
      "license": "LICENSE.txt"
    },
    "extraFiles": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ]
  },
  "description": "E-DUB Audio ses işleme stüdyosu",
  "license": "GPL-3.0-only",
  "author": "Nergal-exe",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nergal-exe/E-DUB-Audio.git"
  },
  "homepage": "https://github.com/Nergal-exe/E-DUB-Audio"
}
